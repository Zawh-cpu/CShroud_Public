<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CShroudApp.Presentation.Ui.App"
             xmlns:local="using:CShroudApp.Presentation.Ui"
             xmlns:viewModels="clr-namespace:CShroudApp.Presentation.Ui.ViewModels"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    
    <Application.DataContext>
        <viewModels:AppViewModel />
    </Application.DataContext>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon ToolTipText="CrimsonShroud" Icon="/Assets/logo.ico">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Settings">
                            <NativeMenu>
                                <NativeMenuItem Header="Show" Command="{Binding ShowCommand}" />
                                <NativeMenuItem Header="Option 2"   />
                                <NativeMenuItemSeparator />
                                <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
                            </NativeMenu>
                        </NativeMenuItem>
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CShroudApp.Presentation.Ui.App"
             xmlns:local="using:CShroudApp.Presentation.Ui"
             x:DataType="viewModels:AppViewModel"
             xmlns:viewModels="clr-namespace:CShroudApp.Presentation.Ui.ViewModels"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    
    <Application.DataContext>
        <viewModels:AppViewModel />
    </Application.DataContext>
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://CShroudApp/Presentation/Ui/Resources/Templates/NotificationTemplates.axaml" />
                <ResourceInclude Source="avares://CShroudApp/Presentation/Ui/Resources/Templates/HeaderNotificationTemplates.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>   
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
    
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon ToolTipText="CrimsonShroud" Icon="/Assets/logo.ico">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open CrimsonShroud" Command="{Binding ShowCommand}" />
                        <NativeMenuItem Header="VPN">
                            <NativeMenu>
                                <NativeMenuItem Header="Enable [Proxy]"/>
                                <NativeMenuItem Header="Change Mode">
                                    <NativeMenu>
                                        <NativeMenuItem Header="VPN"/>
                                        <NativeMenuItem Header="VPN And Proxy"/>
                                        <NativeMenuItem Header="Proxy"/>
                                        <NativeMenuItem Header="Transparent"/>
                                    </NativeMenu>
                                </NativeMenuItem>
                            </NativeMenu>
                        </NativeMenuItem>
                        <NativeMenuItem Header="Open configuration file"/>
                        <NativeMenuItemSeparator/>
                        <NativeMenuItem Header="Exit" Command="{Binding ExitCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "EndpointDefaults": {
      "Protocols": "Http2"
    },
    "Endpoints": {
      "Http": {
        "Url": "http://*:12500"
      },
      "Https": {
        "Url": "https://*:12501"
      }
    },
    "Certificates": {
      "Default": {
        "Path": "Certs/CS-DAW-Frankfurt-1.crt",
        "KeyPath": "Certs/CS-DAW-Frankfurt-1.key"
      }
    }
  }
}
